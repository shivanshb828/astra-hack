# MissionPCB environment. Copy to .env and fill in locally; never commit .env.
#
# All of these are read by the BACKEND only. No credential is exposed to the
# browser: the Vite dev server proxies /api to the backend, and
# /api/integrations reports only whether a credential is present, never its
# value.

# Model provider for chat proposals. Both must be set for provider mode;
# with either missing the app runs deterministic demo mode and labels its
# replies as locally generated rather than attributing them to Astra.
ASTRA_API_KEY=
ASTRA_ENDPOINT=

# Generic aliases, honoured if the Astra-specific names are unset.
MISSIONPCB_MODEL_API_KEY=
MISSIONPCB_MODEL_ENDPOINT=

# SQLite location. Defaults to ./data/missionpcb.db.
MISSIONPCB_DB=
